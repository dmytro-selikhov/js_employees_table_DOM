        if (e.target.tagName === 'TD') {
            var row = e.target.parentElement;
            table.querySelectorAll('tbody tr').forEach(function(tr) {
                tr.classList.remove('active');
            });
            row.classList.add('active');
        }
    });
    var formContainer = document.createElement('div');
    formContainer.classList.add('new-employee-form');
    formContainer.innerHTML = '\n    <label>Name: <input name="name" type="text" data-qa="name" /></label>\n    <label>Position: <input name="position" type="text" data-qa="position" /></label>\n    <label>Office:\n      <select name="office" data-qa="office">\n        <option>Tokyo</option>\n        <option>Singapore</option>\n        <option>London</option>\n        <option>New York</option>\n        <option>Edinburgh</option>\n        <option>San Francisco</option>\n      </select>\n    </label>\n    <label>Age: <input name="age" type="number" data-qa="age" /></label>\n    <label>Salary: <input name="salary" type="text" data-qa="salary" /></label>\n    <button type="button">Save to table</button>\n  ';
    document.body.appendChild(formContainer);
    var showNotification = function(type, message) {
        var notif = document.createElement('div');
        notif.className = type;
        notif.dataset.qa = 'notification';
        notif.textContent = message;
        document.body.appendChild(notif);
        setTimeout(function() {
            notif.remove();
        }, 3000);
    };
    formContainer.querySelector('button').addEventListener('click', function() {
        var nameInput = formContainer.querySelector('[data-qa="name"]').value.trim();
        var position = formContainer.querySelector('[data-qa="position"]').value.trim();
        var office = formContainer.querySelector('[data-qa="office"]').value;
        var age = parseInt(formContainer.querySelector('[data-qa="age"]').value, 10);
        var salaryRaw = formContainer.querySelector('[data-qa="salary"]').value;
        var salary = parseFloat(salaryRaw.replace(/[$,]/g, ''));
        if (nameInput.length < 4) {
            showNotification('error', 'Name must be at least 4 characters');
            return;
        }
        if (age < 18 || age > 90) {
            showNotification('error', 'Age must be between 18 and 90');
            return;
        }
        if (!position || isNaN(salary)) {
            showNotification('error', 'All fields are required');
            return;
        }
        var row = table.tBodies[0].insertRow();
        [
            nameInput,
            position,
            office,
            age,
            "$".concat(salary.toLocaleString('en-US'))
        ].forEach(function(text) {
            var cell = row.insertCell();
            cell.textContent = text;
        });
        showNotification('success', 'Employee added successfully');
    });
    table.addEventListener('dblclick', function(e) {
        var cell = e.target;
        if (cell.tagName !== 'TD' || cell.querySelector('input')) return;
        var oldValue = cell.textContent;
        cell.textContent = '';
        var input = document.createElement('input');
        input.className = 'cell-input';
        input.value = oldValue;
        cell.appendChild(input);
        input.focus();
        var save = function() {
            var newValue = input.value.trim();
            var columnIndex = cell.cellIndex;
            var isSalaryColumn = table.rows[0].cells[columnIndex].textContent === 'Salary';
            if (newValue === '') cell.textContent = oldValue;
            else if (isSalaryColumn) {
                var numeric = parseFloat(newValue.replace(/[$,]/g, ''));
                if (!isNaN(numeric)) cell.textContent = "$".concat(numeric.toLocaleString('en-US'));
                else cell.textContent = oldValue;
            } else cell.textContent = newValue;
